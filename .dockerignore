# Git
.git/

# Virtual environments
.venv/
.FP_env/
FP_env/

# Python cache
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd

# Test cache
.pytest_cache/

# Environment variables and secrets
.env
.env.*

# IDE
.vscode/

# Jupyter temporary files
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Logs
*.log

# Local generated artifacts
artifacts/*

# Allow traversal only to the AWS Lambda directory
!artifacts/AwsLambda/

# Keep all existing AWS Lambda artifacts ignored by default
artifacts/AwsLambda/*

# Allow only the ReActiva campaign Lambdas
!artifacts/AwsLambda/monthly_recommendations/
!artifacts/AwsLambda/monthly_recommendations/**
!artifacts/AwsLambda/monthly_campaign/
!artifacts/AwsLambda/monthly_campaign/**
!artifacts/AwsLambda/campaign_sender/
!artifacts/AwsLambda/campaign_sender/**
!artifacts/AwsLambda/unsubscribe/
!artifacts/AwsLambda/unsubscribe/**

# Operating system files
.DS_Store
Thumbs.db