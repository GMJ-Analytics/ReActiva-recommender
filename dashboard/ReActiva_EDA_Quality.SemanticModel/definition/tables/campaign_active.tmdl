	partition campaign_active = m
		mode: import
		source =
				let
				    Source =
				        Csv.Document(
				            File.Contents(
				                RutaDatosBI & "\campaign_active.csv"
				            ),
				            [
				                Delimiter = ",",
				                Columns = 20,
				                Encoding = 65001,
				                QuoteStyle = QuoteStyle.None
				            ]
				        ),
				
				    #"Encabezados promovidos" =
				        Table.PromoteHeaders(
				            Source,
				            [
				                PromoteAllScalars = true
				            ]
				        ),
				
				    #"Tipos cambiados" =
				        Table.TransformColumnTypes(
				            #"Encabezados promovidos",
				            {
				                {"Campaign ID", type text},
				                {"Campaign Month", type text},
				                {"Customer ID", type text},
				                {"Customer Full Name", type text},
				                {"Customer Email", type text},
				                {"Recommendation 1", type text},
				                {"Recommendation 2", type text},
				                {"Recommendation 3", type text},
				                {"Discount Percent", Int64.Type},
				                {"Coupon Code", type text},
				                {"Scheduled Day", Int64.Type},
				                {"Status", type text},
				                {"Retry Count", Int64.Type},
				                {"Last Attempt At", type datetime},
				                {"Sent At", type datetime},
				                {"Reactivated At", type datetime},
				                {"Coupon Status", type text},
				                {"Coupon Redeemed At", type datetime},
				                {"Coupon Transaction ID", type text},
				                {"Last Error", type text}
				            },
				            "en-US"
				        )
				in
				    #"Tipos cambiados"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

