table campaign_active
	lineageTag: 1f4e9a0b-e151-42f6-8fd0-9407acff5312

	measure 'Clientes Objetivo' =
			
			DISTINCTCOUNT(campaign_active[Customer ID])
		formatString: 0
		lineageTag: dfd0f83b-baa1-415e-8c07-255df403f8cd

	measure Pendientes =
			
			CALCULATE(
			    COUNTROWS(campaign_active),
			    campaign_active[Status] = "PENDING"
			)
		formatString: 0
		lineageTag: 982a5f01-3a8c-46c5-b15b-208e3ea1b279

	measure Enviados =
			
			CALCULATE(
			    COUNTROWS(campaign_active),
			    NOT(ISBLANK(campaign_active[Sent At]))
			)
		formatString: 0
		lineageTag: ffca944c-40d0-4889-aae5-c973a70c7b3d

	measure Fallidos =
			
			CALCULATE(
			    COUNTROWS(campaign_active),
			    campaign_active[Status] = "FAILED"
			)
		formatString: 0
		lineageTag: a579eb5d-3b7a-4023-a758-6eb00af029b7

	measure 'Clientes Reactivados' =
			
			CALCULATE(
			    DISTINCTCOUNT(campaign_active[Customer ID]),
			    NOT(ISBLANK(campaign_active[Reactivated At]))
			)
		formatString: 0
		lineageTag: 4c271a1c-af8e-443c-b2f0-832e1ea43e60

	measure 'Tasa Reactivacion' =
			
			DIVIDE(
			    [Clientes Reactivados],
			    [Enviados],
			    0
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 2206962b-2491-4303-8629-c1d05f3e8608

	measure 'Cupones Redimidos' =
			
			CALCULATE(
			    COUNTROWS(campaign_active),
			    NOT(ISBLANK(campaign_active[Coupon Redeemed At]))
			)
		formatString: 0
		lineageTag: 61b71027-e14c-4434-b036-aff9b7d3e4d8

	measure 'Tasa Redencion' =
			
			DIVIDE(
			    [Cupones Redimidos],
			    [Enviados],
			    0
			)
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 836d82e8-d0ec-4511-8dae-c0a3c9f7fd1c

	measure 'Cupones Activos' =
			
			CALCULATE(
			    COUNTROWS(campaign_active),
			    campaign_active[Coupon Status] = "ACTIVE"
			)
		formatString: 0
		lineageTag: 5369036b-ab4e-49c3-a26b-3e41dda4fdcc

	measure 'Campaña Actual' =
			
			SELECTEDVALUE(
			    campaign_active[Campaign ID],
			    "Sin campaña"
			)
		lineageTag: 33175d7c-0116-4660-8764-b79f14189fb8

	measure 'Mes Campaña' =
			
			SELECTEDVALUE(
			    campaign_active[Campaign Month],
			    "-"
			)
		lineageTag: b58d06e2-0568-4396-a6e3-6eb3f13a4dae

	measure 'Clientes Objetivo Tarjeta' =
			
			FORMAT(
			    [Clientes Objetivo],
			    "#,##0",
			    "es-AR"
			)
		lineageTag: 295df3b5-f050-49f2-a1d7-5cace3d47d1a

	measure 'Descuento Campaña' =
			
			MAX(campaign_active[Discount Percent]) / 100
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 66b92797-17b8-4033-8502-0a266754ab4f

