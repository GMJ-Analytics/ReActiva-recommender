table drift_features_history
	lineageTag: 7d277cd5-0bf8-41ce-a4f0-da096d5c2ba8

	measure 'Es Ultima Corrida Feature' =
			
			VAR UltimoRun =
			    [Ultimo Run ID Drift]
			VAR RunActual =
			    SELECTEDVALUE(drift_features_history[run_id])
			RETURN
			    IF(
			        RunActual = UltimoRun,
			        1,
			        0
			    )
		formatString: 0
		lineageTag: 0525aa0e-eb96-4464-bd00-4c0ccbad0f53

	column run_id
		dataType: string
		lineageTag: 0894acaf-dffe-4c6d-a6b5-d16e2a2e66cb
