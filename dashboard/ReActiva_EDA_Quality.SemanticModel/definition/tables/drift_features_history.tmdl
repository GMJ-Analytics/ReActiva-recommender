	partition drift_features_history = m
		mode: import
		source =
				let
				    Origen = Csv.Document(
				    File.Contents(RutaDatosBI & "\drift_features_history.csv"),
				    [
				        Delimiter=",",
				        Columns=13,
				        Encoding=65001,
				        QuoteStyle=QuoteStyle.None
				    ]
				),
				    #"Encabezados promovidos" = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    #"Tipo cambiado con configuración regional" = Table.TransformColumnTypes(#"Encabezados promovidos", {{"drift_score", type number}, {"drift_threshold", type number}}, "en-US"),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Tipo cambiado con configuración regional",{{"evaluated_at_utc", type datetimezone}, {"drift_detected", type logical}, {"source_max_date", type date}, {"reference_start", type date}, {"reference_end", type date}, {"current_start", type date}, {"current_end", type date}, {"window_days", Int64.Type}})
				in
				    #"Tipo cambiado"

