table drift_summary_history
	lineageTag: 717f093d-b384-4e74-afd5-2ee3ff4aa28b

	measure 'Ultima Corrida Drift' =
			
			MAXX(
			    ALL(drift_summary_history),
			    drift_summary_history[evaluated_at_utc]
			)
		formatString: General Date
		lineageTag: 6898376d-f308-4c06-99c0-9b0bebbcd8fd

	measure 'Estado Drift Actual' =
			
			VAR UltimaFecha =
			    [Ultima Corrida Drift]
			RETURN
			    CALCULATE(
			        SELECTEDVALUE(drift_summary_history[status]),
			        FILTER(
			            ALL(drift_summary_history),
			            drift_summary_history[evaluated_at_utc] = UltimaFecha
			        )
			    )
		lineageTag: 09fe4d61-0e6e-48d4-a1a2-5b3e7b9a1acc

	measure 'Drift Share Actual' =
			
			VAR UltimaFecha =
			    [Ultima Corrida Drift]
			RETURN
			    CALCULATE(
			        MAX(drift_summary_history[drift_share]),
			        FILTER(
			            ALL(drift_summary_history),
			            drift_summary_history[evaluated_at_utc] = UltimaFecha
			        )
			    )
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 53d78f73-3b0f-4b06-bcf6-83df73949783

	measure 'Features con Drift Actual' =
			
			VAR UltimaFecha =
			    [Ultima Corrida Drift]
			RETURN
			    CALCULATE(
			        MAX(drift_summary_history[drifted_columns]),
			        FILTER(
			            ALL(drift_summary_history),
			            drift_summary_history[evaluated_at_utc] = UltimaFecha
			        )
			    )
		formatString: 0
		lineageTag: 71dc51c6-c4b7-4a12-87dc-c68fe7c33943

	measure 'Features Evaluadas Actual' =
			
			VAR UltimaFecha =
			    [Ultima Corrida Drift]
			RETURN
			    CALCULATE(
			        MAX(drift_summary_history[total_columns]),
			        FILTER(
			            ALL(drift_summary_history),
			            drift_summary_history[evaluated_at_utc] = UltimaFecha
			        )
			    )
		formatString: 0
		lineageTag: ff10c830-abe0-44bd-af96-c5e0b8f045c7

	measure 'Features Drift Texto' =
			
			FORMAT([Features con Drift Actual], "0")
			    & " de "
			    & FORMAT([Features Evaluadas Actual], "0")
		lineageTag: 453aed4c-6e23-4d44-b420-e13985b24ef5

	measure 'Ultima Evaluacion Texto' =
			
			VAR UltimaUTC =
			    [Ultima Corrida Drift]
			VAR UltimaIndia =
			    UltimaUTC + TIME(5, 30, 0)
			RETURN
			    FORMAT(
			        UltimaIndia,
			        "dd/MM/yyyy HH:mm"
			    )
		lineageTag: a99677bc-205e-4582-88b2-fc55a9190ccf

	measure 'Ultimo Run ID Drift' =
			
			VAR UltimaFecha =
			    [Ultima Corrida Drift]
			RETURN
			    CALCULATE(
			        SELECTEDVALUE(drift_summary_history[run_id]),
			        FILTER(
			            ALL(drift_summary_history),
			            drift_summary_history[evaluated_at_utc] = UltimaFecha
			        )
			    )
		lineageTag: ebe5b9b4-6223-481f-81a8-885d52be8930

