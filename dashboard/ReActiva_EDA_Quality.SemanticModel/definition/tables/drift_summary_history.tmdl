	partition drift_summary_history = m
		mode: import
		source =
				let
				    Origen = Csv.Document(
				    File.Contents(RutaDatosBI & "\drift_summary_history.csv"),
				    [
				        Delimiter=",",
				        Columns=15,
				        Encoding=65001,
				        QuoteStyle=QuoteStyle.None
				    ]
				),
				    #"Encabezados promovidos" = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(
				    #"Encabezados promovidos",
				    {
				        {"run_id", type text},
				        {"evaluated_at_utc", type datetimezone},
				        {"status", type text},
				        {"reference_rows", Int64.Type},
				        {"current_rows", Int64.Type},
				        {"total_columns", Int64.Type},
				        {"drifted_columns", Int64.Type},
				        {"drift_share", type number},
				        {"dataset_drift_threshold", type number},
				        {"source_max_date", type date},
				        {"reference_start", type date},
				        {"reference_end", type date},
				        {"current_start", type date},
				        {"current_end", type date},
				        {"window_days", Int64.Type}
				    },
				    "en-US"
				)
				in
				    #"Tipo cambiado"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

